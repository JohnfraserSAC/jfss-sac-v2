{
  "rewrites": [
    {
      "source": "/api/x/:path*",
      "destination": "/api/gateway?_px=:path*"
    },
    {
      "source": "/api/sf/go",
      "destination": "/api/go"
    },
    {
      "source": "/api/club-sheet",
      "destination": "/api/clubSheet"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
